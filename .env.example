# Acceso al panel /gestion
ADMIN_USER=administrador
ADMIN_PASSWORD=cambia-esta-clave-segura

# Mínimo 32 caracteres. Genéralo con: openssl rand -hex 32
SESSION_SECRET=cambia-esta-clave-con-una-cadena-de-al-menos-32-caracteres

# Ruta al archivo SQLite. En producción debe apuntar a un volumen persistente.
SQLITE_PATH=data/memories.sqlite

# Normalmente se publica en la raíz del dominio.
BASE_PATH=/
