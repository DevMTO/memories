# Ruta base del sitio. Normalmente se publica en la raíz del dominio.
BASE_PATH=/
# Idiomas publicados; el español es la fuente y siempre se incluye.
ENABLED_LANGS=es,en,pt
# Idioma que se sirve sin prefijo en la URL (`/`); los demás van en `/<idioma>/`.
# Opcional: por defecto el español.
# DEFAULT_LANG=es

# ── PocketBase local (kit): `npm run pb`, `npm run pb:superuser` ─────────────
# URL del PocketBase del que leen el build y /admin.
PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
# Superusuario del dashboard (/_/) de esa instancia; `npm run pb:superuser` lo crea.
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=
# Editor de /admin, que el hook del kit crea en el PocketBase local.
EDITOR_EMAIL=
EDITOR_PASSWORD=
