---
import Layout from "../layouts/Layout.astro";
import { getToursUseCase } from "../infrastructure/di";
import { sitePath } from "../core/site-path";
import heroReelManifest from "../data/hero_reel_manifest.json";
import "./_home.scss";
import "./_hero_video_carousel.scss";

const featuredTours = await getToursUseCase.executeFeatured();
const allExperiences = await getToursUseCase.executeAll();
const packages = await getToursUseCase.executePackages();

const activeExperiences = (allExperiences || []).filter((tour) => tour.isActive !== false);
const featuredActive = (featuredTours || []).filter((tour) => tour.isActive !== false);
const displayTours = (featuredActive.length > 0 ? featuredActive : activeExperiences).slice(0, 3);

const activePackages = (packages || []).filter((pkg) => pkg.isActive !== false);

const normalizeSlug = (value = '') =>
  value
    .toString()
    .trim()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/ñ/g, 'n')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const getDestinationImage = (slug = '') => {
  const cleanSlug = normalizeSlug(slug);

  const imageMap = {
    cusco: '/images/cusco/cusco.png',
    lima: '/images/lima/lima.png',
    ica: '/images/ica/ica.png',
    puno: '/images/puno/puno.png',
    arequipa: '/images/arequipa/arequipa.webp',
    paracas: '/images/ica/ica.png',
    nazca: '/images/ica/ica.png',
    huacachina: '/images/ica/ica.png',
    'machu-picchu': '/images/cusco/cusco.png',
    vinicunca: '/images/cusco/cusco.png',
    palccoyo: '/images/cusco/cusco.png',
    waqrapukara: '/images/cusco/cusco.png',
  };

  return imageMap[cleanSlug] || `/images/${cleanSlug}/${cleanSlug}.png`;
};

const destinationMap = new Map();

activePackages.forEach((pkg) => {
  const packageDestinations = pkg.destinations ?? [];

  if (packageDestinations.length > 0) {
    packageDestinations.forEach((destination) => {
      const slug = normalizeSlug(destination.slug || destination.name);

      if (!slug || destinationMap.has(slug)) return;

      destinationMap.set(slug, {
        id: destination.id || slug,
        name: destination.name,
        slug,
        imageUrl: getDestinationImage(slug),
      });
    });
  }

  if (pkg.destinationName || pkg.destinationSlug) {
    const slug = normalizeSlug(pkg.destinationSlug || pkg.destinationName);

    if (slug && !destinationMap.has(slug)) {
      destinationMap.set(slug, {
        id: slug,
        name: pkg.destinationName || slug,
        slug,
        imageUrl: getDestinationImage(slug),
      });
    }
  }
});
const destinationPriority = ['cusco', 'lima', 'ica', 'puno', 'arequipa'];

const displayDestinations = destinationPriority
  .map((slug) => destinationMap.get(slug))
  .filter(Boolean);
---

<Layout
  title="Memories Travel Perú | Agencia de viajes en Perú"
  mainClass="home-main"
  preloadImage={heroReelManifest.video.poster}
  socialImage={heroReelManifest.video.poster}
>

  <!-- ==================== HERO VIDEO REEL ==================== -->
  <section
    class="home-hero"
    style={`--home-hero-image: url('${sitePath(heroReelManifest.video.poster)}')`}
    data-hero-reel
  >
    <div class="home-hero__media" aria-hidden="true">
      <video
        class="home-hero__video"
        data-hero-video
        muted
        loop
        playsinline
        preload="metadata"
        poster={sitePath(heroReelManifest.video.poster)}
        tabindex="-1"
      >
        <source src={sitePath(heroReelManifest.video.mp4)} type="video/mp4" />
      </video>
    </div>

    <div class="home-hero__overlay"></div>

    <div class="hero-water-interaction" data-hero-interaction aria-hidden="true">
      <div class="hero-water-interaction__surface" data-water-surface></div>
    </div>

    <div class="container home-hero__content">
      <span class="home-eyebrow home-eyebrow--light">Agencia de viajes · Tour operador</span>

      <h1 class="hero-title">
        MEMORIES
        <em>Travel Perú</em>
      </h1>

      <div class="hero-rule"></div>

      <p class="hero-tagline">
        Experiencias curadas y exclusivas. Conectamos tu espíritu<br />
        con la esencia viva y eterna del Perú.
      </p>

      <div class="hero-actions">
        <a href={sitePath('/packages')} class="home-btn home-btn--primary" data-i18n="nav.designTrip">Diseña tu viaje</a>
        <a href="#home-tours" class="home-btn home-btn--ghost">Explorar Tours ↓</a>
      </div>
    </div>

  </section>

  <!-- ==================== EXPERIENCE GATEWAY ==================== -->
  <section class="experience-gateway reveal-up" aria-labelledby="experience-gateway-title">
    <div class="container">
      <div class="experience-gateway__header">
        <span class="home-eyebrow home-eyebrow--dark">Encuentra tu forma de viajar</span>
        <h2 id="experience-gateway-title">Todo el Perú, <em>a tu ritmo</em></h2>
        <p>Explora experiencias de un día, rutas de trekking y programas completos con información clara antes de reservar.</p>
      </div>

      <div class="experience-gateway__grid">
        <a href={sitePath('/tours')} class="experience-gateway__card">
          <div><strong>Tours</strong><p>Excursiones culturales, naturaleza y experiencias de uno o varios días.</p></div>
          <span class="experience-gateway__arrow" aria-hidden="true">→</span>
        </a>
        <a href={sitePath('/trekkings')} class="experience-gateway__card">
          <div><strong>Trekking</strong><p>Caminatas andinas con itinerario, equipo recomendado y servicios detallados.</p></div>
          <span class="experience-gateway__arrow" aria-hidden="true">→</span>
        </a>
        <a href={sitePath('/packages')} class="experience-gateway__card">
          <div><strong>Paquetes</strong><p>Programas integrales para recorrer varios destinos con acompañamiento experto.</p></div>
          <span class="experience-gateway__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== ESNNA ==================== -->
  <section class="home-esnna reveal-up" aria-labelledby="esnna-title">
    <div class="container home-esnna__inner">
      <div class="home-esnna__copy">
        <span class="home-eyebrow home-eyebrow--dark" data-i18n="esnna.eyebrow">Turismo responsable</span>
        <h2 id="esnna-title" data-i18n="esnna.title">Protegemos a niñas, niños y adolescentes.</h2>
        <p data-i18n="esnna.first">En Memories Travel Perú promovemos viajes seguros, respetuosos y libres de toda forma de explotación sexual de niñas, niños y adolescentes.</p>
        <a href={sitePath('/esnna')} class="home-esnna__link"><span data-i18n="esnna.learn">Conoce nuestro compromiso</span><span aria-hidden="true">→</span></a>
      </div>

      <a href={sitePath('/esnna')} class="home-esnna__badge" aria-label="Conoce nuestro compromiso ESNNA">
        <img src={sitePath('/images/esnna-1.png.webp')} alt="Protégeme: turismo responsable para prevenir la explotación sexual de niñas, niños y adolescentes" width="421" height="274" loading="lazy" />
      </a>
    </div>
  </section>

  <!-- ==================== RECOGNITIONS ==================== -->
  <section class="recognitions-section reveal-up">
    <div class="recognitions-label-wrap container">
      <span>Reconocidos estratégicamente por</span>
    </div>
    <div class="recognitions-row">
      <img src={sitePath('/images/mincetur.png')}    alt="Mincetur" />
      <img src={sitePath('/images/promperu.png')}    alt="PromPerú" />
      <img src={sitePath('/images/marcaperu.png')}   alt="Marca Perú" />
      <img src={sitePath('/images/tripadvisor.png')} alt="Tripadvisor" />
    </div>
  </section>

  <!-- ==================== TRANSFORM ==================== -->
  <section class="transform-section reveal-up">
    <div class="container transform-grid">
      <div class="transform-copy">
        <div class="transform-copy__header">
          <span class="section-num-label">01</span>
          <span class="home-eyebrow">Experiencias exclusivas</span>
        </div>

        <h2>
          Viajes Que
          <em>Transforman</em>
        </h2>

        <p>
          Somos arquitectos de experiencias. No solo vendemos tours, diseñamos
          momentos que se convierten en recuerdos imborrables.
        </p>

        <div class="transform-stats">
          <div class="transform-stat">
            <strong>Guías Nativos</strong>
            <span>Certificados y bilingues</span>
          </div>
          <div class="transform-stat">
            <strong>A Tu Medida</strong>
            <span>Personalización total</span>
          </div>
          <div class="transform-stat">
            <strong>+12 Años</strong>
            <span>Experiencia probada</span>
          </div>
        </div>

        <a href="#destinations" class="text-link">Ver más destinos →</a>
      </div>

      <div class="transform-image">
        <img src={sitePath('/images/viajes.png')} alt="Viajes que transforman" />
      </div>
    </div>
  </section>

  <!-- ==================== TOURS ==================== -->
  <section id="home-tours" class="home-tours-section reveal-up">
    <div class="container">
      <div class="home-section-header">
        <div class="home-section-header__top">
          <span class="section-num-label">02</span>
          <span class="home-eyebrow home-eyebrow--dark">Experiencias exclusivas</span>
        </div>
        <h2>Nuestros <em>Tours</em></h2>
        <p>
          Itinerarios diseñados meticulosamente para viajeros que buscan autenticidad.
        </p>
      </div>

      <div class="home-tours-grid">
        {
          displayTours.map((tour, index) => {
            const fallbackImages = [
              "/images/cusco/cusco.png",
              "/images/cusco/montana-7-colores.webp",
              "/images/lima/lima.png",
            ];

            const imageUrl =
              tour.imageUrl &&
              tour.imageUrl.trim() !== "" &&
              !tour.imageUrl.includes("---")
                ? tour.imageUrl
                : fallbackImages[index] || "/images/cusco/cusco.png";

            const priceLabel =
              tour.price && tour.price > 0
                ? `$ ${tour.price.toLocaleString()}`
                : "A medida";

            const durationLabel = tour.durationNights
              ? `${tour.durationDays}D / ${tour.durationNights}N`
              : `${tour.durationDays || 1} DÍA${tour.durationDays === 1 ? "" : "S"}`;

            return (
              <article class="home-tour-card">
                <a href={sitePath(`/tours/${tour.slug || tour.id}`)} class="home-tour-card__link">
                  <figure class="home-tour-card__figure">
                    <img src={sitePath(imageUrl)} alt={tour.title} />
                    <span class="home-tour-card__badge">{durationLabel}</span>
                  </figure>

                  <div class="home-tour-card__body">
                    <span class="home-tour-card__location notranslate" translate="no">
                      {(tour.destinationName || tour.location || "Perú").toUpperCase()}
                    </span>

                    <h3>{tour.title}</h3>

                    <p>
                      {tour.shortDescription ||
                        tour.description ||
                        "Descubre Perú con una experiencia diseñada a tu medida."}
                    </p>

                    <div class="home-tour-card__footer">
                      <div class="home-tour-card__price">
                        <span>{tour.price && tour.price > 0 ? "Desde" : "Consultar"}</span>
                        <strong>{priceLabel}</strong>
                      </div>
                      <span class="tour-card-arrow">→</span>
                    </div>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>

      <div class="home-tours-footer">
        <a href={sitePath('/tours')} class="home-btn home-btn--outline-dark">Ver todos los tours</a>
      </div>
    </div>
  </section>

  <!-- ==================== DESTINATIONS ==================== -->
  <section id="destinations" class="home-destinations-section reveal-up">
    <div class="container">
      <div class="home-section-header destinations-header">
        <div>
          <div class="home-section-header__top">
            <span class="section-num-label">03</span>
            <span class="home-eyebrow home-eyebrow--dark">Colección 2026</span>
          </div>
          <h2>Destinos <em>Icónicos</em></h2>
        </div>
        <a href="#destinations" class="destinations-link">Ver más destinos →</a>
      </div>

      {
        displayDestinations.length > 0 ? (
          <div class="home-destinations-grid">
            {displayDestinations.map((destination, index) => (
              <a
                href={sitePath(`/destinations/${destination.slug}`)}
                class={`destination-card ${
                  index === 0 ? 'destination-card--large' : index === 1 ? 'destination-card--wide' : ''
                }`}
              >
                <img src={sitePath(destination.imageUrl)} alt={destination.name} />
                <div class="destination-card__overlay"></div>
                <div class="destination-card__content">
                  <span class="destination-card__index">0{index + 1}</span>
                  <h3 class="notranslate" translate="no">{destination.name}</h3>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="home-destinations-empty">
            <p>No hay destinos disponibles en los paquetes activos.</p>
          </div>
        )
      }
    </div>
  </section>

</Layout>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero-reel]");
  const heroVideo = hero?.querySelector<HTMLVideoElement>("[data-hero-video]");
  const interactionLayer = hero?.querySelector<HTMLElement>("[data-hero-interaction]");
  const waterSurface = hero?.querySelector<HTMLElement>("[data-water-surface]");

  if (hero && heroVideo && interactionLayer && waterSurface) {
    const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const precisePointerQuery = window.matchMedia("(hover: hover) and (pointer: fine)");
    const saveDataEnabled = Boolean(
      (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData
    );

    let heroIsVisible = true;
    let holdPaused = false;
    let activePointerId: number | null = null;
    let pointerDownAt = 0;
    let pointerDownX = 0;
    let pointerDownY = 0;
    let pointerFrame = 0;

    const shouldRemainPaused = () =>
      reducedMotionQuery.matches || saveDataEnabled || holdPaused || !heroIsVisible || document.hidden;

    const syncPlayback = async () => {
      if (shouldRemainPaused()) {
        heroVideo.pause();
        return;
      }

      try {
        await heroVideo.play();
      } catch {
        // Autoplay can be rejected by the browser. The poster remains as fallback.
      }
    };

    const setPointerPosition = (clientX: number, clientY: number) => {
      cancelAnimationFrame(pointerFrame);
      pointerFrame = requestAnimationFrame(() => {
        const bounds = interactionLayer.getBoundingClientRect();
        const x = Math.max(0, Math.min(clientX - bounds.left, bounds.width));
        const y = Math.max(0, Math.min(clientY - bounds.top, bounds.height));

        interactionLayer.style.setProperty("--water-x", `${x}px`);
        interactionLayer.style.setProperty("--water-y", `${y}px`);
        interactionLayer.classList.add("is-pointer-present");
      });
    };

    const spawnWaterImpact = (clientX: number, clientY: number, allowSatellite = true) => {
      if (reducedMotionQuery.matches) return;

      const bounds = interactionLayer.getBoundingClientRect();
      const x = Math.max(0, Math.min(clientX - bounds.left, bounds.width));
      const y = Math.max(0, Math.min(clientY - bounds.top, bounds.height));
      const impact = document.createElement("span");
      const ringCount = 3 + Math.floor(Math.random() * 3);
      const lifetime = 1250 + Math.floor(Math.random() * 450);

      impact.className = "hero-water-impact";
      impact.style.setProperty("--impact-x", `${x}px`);
      impact.style.setProperty("--impact-y", `${y}px`);
      impact.style.setProperty("--impact-rotation", `${-14 + Math.random() * 28}deg`);
      impact.style.setProperty("--impact-glow", `${0.72 + Math.random() * 0.28}`);

      const drop = document.createElement("span");
      drop.className = "hero-water-impact__drop";
      impact.append(drop);

      for (let index = 0; index < ringCount; index += 1) {
        const ring = document.createElement("span");
        const offsetX = index === 0 ? 0 : (Math.random() - 0.5) * 16;
        const offsetY = index === 0 ? 0 : (Math.random() - 0.5) * 9;

        ring.className = "hero-water-impact__ring";
        ring.style.setProperty("--ring-delay", `${index * (52 + Math.random() * 36)}ms`);
        ring.style.setProperty("--ring-duration", `${820 + index * 105 + Math.random() * 240}ms`);
        ring.style.setProperty("--ring-scale", `${0.82 + index * 0.25 + Math.random() * 0.22}`);
        ring.style.setProperty("--ring-x", `${offsetX}px`);
        ring.style.setProperty("--ring-y", `${offsetY}px`);
        impact.append(ring);
      }

      waterSurface.append(impact);
      window.setTimeout(() => impact.remove(), lifetime);

      if (allowSatellite && Math.random() > 0.58) {
        const satelliteX = clientX + (Math.random() - 0.5) * 86;
        const satelliteY = clientY + (Math.random() - 0.5) * 52;
        window.setTimeout(() => {
          if (document.contains(interactionLayer)) spawnWaterImpact(satelliteX, satelliteY, false);
        }, 90 + Math.random() * 80);
      }
    };

    const finishHold = (event: PointerEvent, allowImpact: boolean) => {
      if (activePointerId !== event.pointerId) return;

      const elapsed = performance.now() - pointerDownAt;
      const travel = Math.hypot(event.clientX - pointerDownX, event.clientY - pointerDownY);
      const isSimpleClick = allowImpact && elapsed < 280 && travel < 14;

      holdPaused = false;
      activePointerId = null;
      hero.classList.remove("is-reel-held");

      if (interactionLayer.hasPointerCapture(event.pointerId)) {
        interactionLayer.releasePointerCapture(event.pointerId);
      }

      if (isSimpleClick) spawnWaterImpact(event.clientX, event.clientY);
      void syncPlayback();
    };

    interactionLayer.addEventListener("pointermove", (event) => {
      if (precisePointerQuery.matches) setPointerPosition(event.clientX, event.clientY);
    });

    interactionLayer.addEventListener("pointerenter", (event) => {
      if (precisePointerQuery.matches) setPointerPosition(event.clientX, event.clientY);
    });

    interactionLayer.addEventListener("pointerleave", () => {
      if (activePointerId === null) interactionLayer.classList.remove("is-pointer-present");
    });

    interactionLayer.addEventListener("pointerdown", (event) => {
      if (event.button !== 0 || activePointerId !== null) return;

      activePointerId = event.pointerId;
      pointerDownAt = performance.now();
      pointerDownX = event.clientX;
      pointerDownY = event.clientY;
      holdPaused = true;
      interactionLayer.setPointerCapture(event.pointerId);
      hero.classList.add("is-reel-held");
      setPointerPosition(event.clientX, event.clientY);
      heroVideo.pause();
    });

    interactionLayer.addEventListener("pointerup", (event) => finishHold(event, true));
    interactionLayer.addEventListener("pointercancel", (event) => finishHold(event, false));
    interactionLayer.addEventListener("contextmenu", (event) => event.preventDefault());

    heroVideo.addEventListener("loadeddata", () => hero.classList.add("is-video-ready"));
    heroVideo.addEventListener("canplay", () => hero.classList.add("is-video-ready"));
    heroVideo.addEventListener("playing", () => hero.classList.add("is-video-ready"));

    const heroVisibilityObserver = new IntersectionObserver(
      ([entry]) => {
        heroIsVisible = entry.isIntersecting;
        void syncPlayback();
      },
      { threshold: 0.08 }
    );

    heroVisibilityObserver.observe(hero);
    document.addEventListener("visibilitychange", () => void syncPlayback());
    reducedMotionQuery.addEventListener?.("change", () => void syncPlayback());

    if (heroVideo.readyState >= 2) hero.classList.add("is-video-ready");
    void syncPlayback();
  }

  const revealCallback = (
    entries: IntersectionObserverEntry[],
    observer: IntersectionObserver
  ) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("is-revealed");
        observer.unobserve(entry.target);
      }
    });
  };

  const revealObserver = new IntersectionObserver(revealCallback, {
    threshold: 0.12,
    rootMargin: "0px 0px -40px 0px",
  });

  document.querySelectorAll(".reveal-up").forEach((el) => {
    revealObserver.observe(el);
  });
</script>

<style is:global>
  html { scroll-behavior: smooth; }

  .reveal-up {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.85s ease, transform 0.85s ease;
  }

  .reveal-up.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
</style>
