---
import Layout from '../layouts/Layout.astro';
import PackageCard from '../components/PackageCard.astro';
import { getToursUseCase } from '../infrastructure/di';
import { sitePath } from '../core/site-path';
import './_packages.scss';

export const prerender = true;

const url = Astro.url;

const selectedStyle = url.searchParams.get('style') || '';
const selectedDestination = url.searchParams.get('destination') || '';
const maxPrice = Number(url.searchParams.get('price') || '10000');

const allPackagesRaw = await getToursUseCase.executePackages();

const allPackages = (allPackagesRaw || []).filter((pkg) => pkg?.isActive !== false);

const destinations = Array.from(
  new Set(
    allPackages.flatMap((pkg) => {
      const fromDestinations = pkg.destinations?.map((d) => d.name) ?? [];
      const fromSingle = pkg.destinationName ? [pkg.destinationName] : [];
      return [...fromDestinations, ...fromSingle];
    })
  )
).filter(Boolean);

const styles = Array.from(
  new Set(
    allPackages.flatMap((pkg) => pkg.features ?? [])
  )
).filter(Boolean);

const filteredPackages = allPackages.filter((pkg) => {
  const pkgDestinations = [
    ...(pkg.destinations?.map((d) => d.name.toLowerCase()) ?? []),
    ...(pkg.destinationName ? [pkg.destinationName.toLowerCase()] : []),
  ];

  const pkgFeatures = (pkg.features ?? []).map((item) => item.toLowerCase());

  const matchesStyle = selectedStyle
    ? pkgFeatures.includes(selectedStyle.toLowerCase())
    : true;

  const matchesDestination = selectedDestination
    ? pkgDestinations.includes(selectedDestination.toLowerCase())
    : true;

  const matchesPrice = pkg.price ? pkg.price <= maxPrice : true;

  return matchesStyle && matchesDestination && matchesPrice;
});

---

<Layout title="Nuestros Paquetes | Memories Travel Perú" mainClass="packages-page">
  <!-- HERO -->
  <section class="packages-hero" style={`--packages-hero-image: url('${sitePath('/images/hero.webp')}')`}>
    <div class="packages-hero__overlay"></div>

    <div class="container packages-hero__content">
      <h1 data-i18n="listings.packages">Nuestros paquetes</h1>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="packages-section">
    <div class="container packages-layout">
      <!-- SIDEBAR -->
      <aside class="packages-sidebar">
        <button type="button" class="filters-toggle" id="packages-filter-toggle" aria-controls="packages-filters" aria-expanded="false">
          <svg class="filters-toggle__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h10M18 7h2M4 17h2M10 17h10M14 4v6M7 14v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <span>Filtrar resultados</span>
          <svg class="filters-toggle__chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m7 10 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <form method="GET" class="filters-box" id="packages-filters">
          <div class="filter-group">
            <h3 data-i18n="filters.travelStyles">Estilos de viaje</h3>

            <div class="filter-options">
              <label class="filter-check">
                <input
                  type="radio"
                  name="style"
                  value=""
                  checked={selectedStyle === ''}
                />
                <span data-i18n="filters.all">Todos</span>
              </label>

              {styles.slice(0, 6).map((style) => (
                <label class="filter-check">
                  <input
                    type="radio"
                    name="style"
                    value={style}
                    checked={selectedStyle === style}
                  />
                  <span>{style}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="filter-group">
            <h3 data-i18n="filters.destination">País / destino</h3>

            <div class="filter-options">
              <label class="filter-check">
                <input
                  type="radio"
                  name="destination"
                  value=""
                  checked={selectedDestination === ''}
                />
                <span data-i18n="filters.all">Todos</span>
              </label>

              {destinations.slice(0, 8).map((destination) => (
                <label class="filter-check">
                  <input
                    type="radio"
                    name="destination"
                    value={destination}
                    checked={selectedDestination === destination}
                  />
                  <span class="notranslate" translate="no">{destination}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="filter-group">
            <h3 data-i18n="filters.price">Precio</h3>

            <div class="filter-price">
              <input
                type="range"
                name="price"
                min="0"
                max="10000"
                step="100"
                value={maxPrice}
                onInput="this.nextElementSibling.value = this.value"
              />
              <output>${maxPrice}</output>
            </div>

            <div class="filter-price-labels">
              <span>$ 0</span>
              <span>$ 10000</span>
            </div>
          </div>

          <div class="filter-actions">
            <button type="submit" class="filter-btn">
              <span data-i18n="filters.search">Buscar</span>
            </button>

            <a href={sitePath('/packages')} class="filter-reset">
              <span data-i18n="filters.clear">Limpiar filtros</span>
            </a>
          </div>
        </form>
      </aside>

      <!-- GRID -->
      <div class="packages-main">
        {filteredPackages.length > 0 ? (
          <div class="packages-grid">
            {filteredPackages.map((pkg) => (
              <PackageCard pkg={pkg} />
            ))}
          </div>
        ) : (
          <div class="packages-empty">
            <h3>No encontramos paquetes con esos filtros</h3>
            <p>Prueba otra combinación o solicita una propuesta personalizada por WhatsApp.</p>
            <a href={sitePath('/packages')}>Limpiar filtros</a>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>

<script>
  const packageFiltersToggle = document.querySelector<HTMLButtonElement>('#packages-filter-toggle');
  const packageFiltersSidebar = document.querySelector<HTMLElement>('.packages-sidebar');
  const compactPackageFiltersQuery = window.matchMedia('(max-width: 1080px)');

  const closePackageFilters = () => {
    packageFiltersSidebar?.classList.remove('is-filter-open');
    packageFiltersToggle?.setAttribute('aria-expanded', 'false');
  };

  packageFiltersToggle?.addEventListener('click', () => {
    const isOpen = packageFiltersSidebar?.classList.toggle('is-filter-open') || false;
    packageFiltersToggle.setAttribute('aria-expanded', String(isOpen));
  });

  compactPackageFiltersQuery.addEventListener('change', closePackageFilters);
</script>
