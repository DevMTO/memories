---
import Layout from "../../layouts/Layout.astro";
import ComingSoon from "../../components/ui/ComingSoon.astro";
import { getLangParams, pageLang, pagePath, useT } from '../../i18n/i18n';

export const getStaticPaths = () => getLangParams().map((params) => ({ params }));

const lang = pageLang(Astro.params);
const t = useT(lang);

---

<Layout title={t('Vuelos')}>
  <ComingSoon
    eyebrow={t('Muy pronto')}
    title={t('Estamos preparando tus vuelos')}
    message={t('Muy pronto podrás reservar tus vuelos directamente con nosotros. Mientras tanto, nuestro equipo puede ayudarte a cotizarlos a medida.')}
  >
    <svg
      slot="icon"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M21 3 3 10.5l7 2.5 2.5 7L21 3Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
      <path d="M21 3 10.5 13.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  </ComingSoon>
</Layout>
