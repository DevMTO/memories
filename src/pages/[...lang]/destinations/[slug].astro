---
import Layout from '../../../layouts/Layout.astro';
import HeroImage from '../../../components/ui/HeroImage.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import { destination as destinationSchema } from '../../../lib/schema';
import { summarize } from '../../../lib/text';
import PackageCard from '../../../components/PackageCard.astro';
import TourCard from '../../../components/TourCard.astro';
import { sitePath } from '../../../lib/site-path';
import { getAll, getPackages } from '../../../lib/services/catalog';
import { getDestinationPage, getDestinationPages } from '../../../lib/services/destinations';
import './_destination-detail.scss';
import { getLangParams, pageLang, pagePath, useT } from '../../../i18n/i18n';


export async function getStaticPaths() {
  return (await getDestinationPages()).flatMap(({ slug }) => getLangParams().map(({ lang }) => ({ params: { lang, slug } })));
}

const lang = pageLang(Astro.params);
const t = useT(lang);

const { slug } = Astro.params;

const normalizeSlug = (value = '') =>
  value
    .toString()
    .trim()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/ñ/g, 'n')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const destinationSlug = normalizeSlug(slug || '');

const destination = await getDestinationPage(destinationSlug, lang);

if (!destination) {
  return Astro.redirect(pagePath(lang, '/'));
}

const destinationImage = sitePath(destination.imageUrl);
const description = summarize([destination.description]);
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const destinationTitleSuffix = destination.title.startsWith(destination.name)
  ? destination.title.slice(destination.name.length)
  : destination.title;

const packagesRaw = await getPackages(lang);
const toursRaw = await getAll(lang);

const activePackages = (packagesRaw || []).filter((pkg) => pkg.isActive !== false);
const activeTours = (toursRaw || []).filter((tour) => tour.isActive !== false);

const destinationAliases: Record<string, string[]> = {
  cusco: [
    'cusco',
    'machu-picchu',
    'valle-sagrado',
    'laguna-humantay',
    'vinicunca',
    'palccoyo',
    'waqrapukara',
    'maras',
    'moray',
    'aguas-calientes',
  ],
  lima: ['lima'],
  ica: ['ica', 'paracas', 'nazca', 'huacachina'],
  puno: ['puno', 'titicaca', 'uros', 'taquile'],
  arequipa: ['arequipa', 'colca', 'chivay'],
};

const aliases = destinationAliases[destinationSlug] || [destinationSlug];

const belongsToDestination = (item: any) => {
  const itemSlugs = [
    item.destinationSlug,
    item.destinationName,
    item.location,
    ...(item.cities || []),
    ...(item.destinations?.map((d: any) => d.slug) || []),
    ...(item.destinations?.map((d: any) => d.name) || []),
  ]
    .filter(Boolean)
    .map((value) => normalizeSlug(value));

  return itemSlugs.some((itemSlug) =>
    aliases.some((alias) => itemSlug.includes(alias) || alias.includes(itemSlug))
  );
};

const destinationPackages = activePackages.filter(belongsToDestination);
const destinationTours = activeTours.filter(belongsToDestination);

const fallbackPackageImages = [
  destination.imageUrl,
  '/images/cusco/cusco.png',
  '/images/lima/lima.png',
  '/images/ica/ica.png',
];

const withSafeImage = (item: any, index: number) => ({
  ...item,
  imageUrl:
    item.imageUrl &&
    item.imageUrl.trim() !== '' &&
    !item.imageUrl.includes('---')
      ? item.imageUrl
      : fallbackPackageImages[index % fallbackPackageImages.length],
});
---

<Layout
  title={`${destination.name} | ${t('Destinos')} Memories Travel Perú`}
  description={description}
  socialImage={destination.imageUrl}
  schema={destinationSchema(destination, description, pageUrl, Astro.site ?? Astro.url)}
  mainClass="destination-detail-main"
>
  <section class="destination-hero">
    <HeroImage src={destinationImage} srcSmall={destination.imageUrlSmall && sitePath(destination.imageUrlSmall)} alt={destination.name} />
    <div class="destination-hero__overlay"></div>

    <div class="container destination-hero__content">
      <Breadcrumbs items={[{ name: destination.name, href: Astro.url.pathname }]} />
      <span>{destination.eyebrow}</span>
      <h1 class="notranslate" translate="no">{destination.name}</h1>
      <p>{destination.description}</p>
    </div>
  </section>

  <div class="container destination-info-wrapper">
    <div class="destination-info-bar">
      <div>
        <span>{t('Altitud')}</span>
        <strong>{destination.altitude || t('Variable')}</strong>
      </div>

      <div>
        <span>{t('Clima')}</span>
        <strong>{destination.climate || t('Según temporada')}</strong>
      </div>

      <div>
        <span>{t('Mejor temporada')}</span>
        <strong>{destination.bestSeason || t('Todo el año')}</strong>
      </div>

      <div>
        <span>{t('Experiencias')}</span>
        <strong>{destinationPackages.length + destinationTours.length}</strong>
      </div>
    </div>
  </div>

  <section class="destination-intro-section">
    <div class="container destination-intro-grid">
      <div>
        <span class="destination-eyebrow">{t('Destino destacado')}</span>
        <h2><span class="notranslate" translate="no">{destination.name}</span>{destinationTitleSuffix}</h2>
      </div>

      <p>{destination.description}</p>
    </div>
  </section>

  <section class="destination-products-section">
    <div class="container">
      <div class="destination-section-header">
        <span class="destination-eyebrow">{t('Paquetes disponibles')}</span>
        <h2>{t('Viajes a')} <span class="notranslate" translate="no">{destination.name}</span></h2>
        <p>
          {t('Programas diseñados para conocer este destino con una operación organizada, rutas cuidadas y acompañamiento profesional.')}
        </p>
      </div>

      {
        destinationPackages.length > 0 ? (
          <div class="destination-grid">
            {destinationPackages.map((pkg, index) => (
              <PackageCard pkg={withSafeImage(pkg, index)} />
            ))}
          </div>
        ) : (
          <div class="destination-empty">
            <h3>{t('No hay paquetes activos para')} <span class="notranslate" translate="no">{destination.name}</span></h3>
            <p>
              {t('Puedes solicitar una propuesta personalizada para este destino.')}
            </p>
          </div>
        )
      }
    </div>
  </section>

  {
    destinationTours.length > 0 && (
      <section class="destination-products-section destination-products-section--tours">
        <div class="container">
          <div class="destination-section-header">
            <span class="destination-eyebrow">{t('Experiencias seleccionadas')}</span>
            <h2>{t('Tours en')} <span class="notranslate" translate="no">{destination.name}</span></h2>
            <p>
              {t('Actividades y recorridos para complementar tu visita con cultura, paisajes y experiencias locales.')}
            </p>
          </div>

          <div class="destination-grid">
            {destinationTours.map((tour, index) => (
              <TourCard tour={withSafeImage(tour, index)} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="destination-tips-section">
    <div class="container destination-tips-grid">
      <article>
        <span>{t('Consejo de viaje')}</span>
        <h3>{t('Planifica con anticipación')}</h3>
        <p>
          {t('Algunos ingresos, trenes y horarios pueden tener disponibilidad limitada. Reservar con tiempo ayuda a organizar mejor la ruta.')}
        </p>
      </article>

      <article>
        <span>{t('Experiencia local')}</span>
        <h3>{t('Viaja con contexto')}</h3>
        <p>
          {t('Cada destino tiene historia, cultura y particularidades. Un buen guiado hace que la experiencia sea más completa y significativa.')}
        </p>
      </article>

      <article>
        <span>{t('Operación')}</span>
        <h3>{t('Logística organizada')}</h3>
        <p>
          {t('Traslados, tiempos de ruta, ingresos y coordinación son claves para que el viaje fluya sin preocupaciones.')}
        </p>
      </article>
    </div>
  </section>
</Layout>
