---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { sitePath } from '../../core/site-path';
import { getToursUseCase } from '../../infrastructure/di';
import './_detail.scss';

export async function getStaticPaths() {
  const tours = await getToursUseCase.executeAll();
  return tours.map((tour) => ({
    params: { id: tour.slug },
  }));
}

const { id } = Astro.params;

const tour =
  id
    ? (await getToursUseCase.executeById(id)) ||
      (await getToursUseCase.executeBySlug(id))
    : null;

if (!tour) {
  return Astro.redirect(sitePath('/tours'));
}

const features = tour.features ?? [];
const highlights = tour.highlights ?? [];
const itinerary = tour.itinerary ?? [];
const includes = tour.includes ?? [];
const notIncludes = tour.notIncludes ?? [];
const whatToBring = tour.whatToBring ?? [];
const gallery = tour.gallery ?? [];

const heroImage =
  tour.imageUrl &&
  tour.imageUrl.trim() !== '' &&
  !tour.imageUrl.includes('---')
    ? sitePath(tour.imageUrl)
    : sitePath('/images/cusco/cusco.png');

const durationDays = tour.durationDays || 1;
const durationNights = tour.durationNights || 0;

const durationText = durationNights
  ? `${durationDays} días / ${durationNights} noches`
  : `${durationDays} día${durationDays === 1 ? '' : 's'}`;

const heroDuration = durationNights
  ? `${durationDays} días / ${durationNights} noches`
  : `${durationDays} día${durationDays === 1 ? '' : 's'}`;

const destinationName = tour.destinationName || tour.location || 'Perú';

const whatsappMessage = `Hola, quiero información sobre el tour: ${tour.title}`;

const galleryImages = (
  gallery.length > 0
    ? gallery
    : [
        '/images/cusco/cusco.png',
        '/images/hero.webp',
        '/images/lima/lima.png',
      ]
).map(sitePath);

const getDayImages = (dayIndex: number) => {
  if (galleryImages.length === 0) return [];
  const first = galleryImages[dayIndex % galleryImages.length];
  const second = galleryImages[(dayIndex + 1) % galleryImages.length];
  return first === second ? [first] : [first, second];
};

const reviews = [
  {
    name: 'María Fernanda Rojas',
    location: 'Lima, Perú',
    rating: 5,
    text: `El guía fue espectacular, conocía cada rincón de ${destinationName} y la organización fue impecable de principio a fin. Totalmente recomendado.`,
  },
  {
    name: 'James Whitfield',
    location: 'Reino Unido',
    rating: 5,
    text: 'Best trip of my life. Everything was perfectly organized and the views were absolutely breathtaking. Our guide made the experience unforgettable.',
  },
  {
    name: 'Carla Medina',
    location: 'Arequipa, Perú',
    rating: 4,
    text: 'Muy buena experiencia, el transporte llegó puntual y el equipo estuvo pendiente de todos los detalles. Repetiría sin dudarlo.',
  },
];

const getInitials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<Layout title={`${tour.title} | Memories Travel Perú`} mainClass="tour-detail-main">
  <!-- HERO -->
  <section class="tour-hero" style={`background-image: url('${heroImage}');`}>
    <div class="tour-hero__overlay"></div>

    <div class="container tour-hero__content">
      <span class="tour-hero__eyebrow">
        {heroDuration.toUpperCase()} {durationNights ? '(PRIVADO O GRUPO PEQUEÑO)' : '(EXPERIENCIA PERSONALIZADA)'}
      </span>

      <h1>{tour.title}</h1>

      <p>
        {tour.shortDescription ||
          'Experiencias curadas y exclusivas. Conectamos tu espíritu con la esencia viva y eterna del Perú.'}
      </p>
    </div>
  </section>

  <!-- INFO BAR -->
  <div class="container tour-info-wrapper">
    <div class="tour-info-bar">
      <div class="tour-info-item">
        <svg class="tour-info-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6" />
          <path d="M12 7.5v4.8l3.2 1.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="tour-info-label">Duración</span>
        <span class="tour-info-value">{durationText}</span>
      </div>

      <div class="tour-info-item">
        <svg class="tour-info-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 21s7-6.4 7-12a7 7 0 1 0-14 0c0 5.6 7 12 7 12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          <circle cx="12" cy="9" r="2.4" stroke="currentColor" stroke-width="1.6" />
        </svg>
        <span class="tour-info-label">Destino</span>
        <span class="tour-info-value">{destinationName}</span>
      </div>

      <div class="tour-info-item">
        <svg class="tour-info-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="8.7" cy="8" r="2.6" stroke="currentColor" stroke-width="1.6" />
          <path d="M3.5 19.2c0-2.9 2.3-4.8 5.2-4.8s5.2 1.9 5.2 4.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <circle cx="16.6" cy="8.6" r="2.1" stroke="currentColor" stroke-width="1.5" />
          <path d="M14.9 14.9c2.1.3 3.6 1.9 3.6 4.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <span class="tour-info-label">Servicio</span>
        <span class="tour-info-value">{features[0] || 'Tour guiado'}</span>
      </div>

      <div class="tour-info-item">
        <svg class="tour-info-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M11.4 3.3 20 11.9l-8.1 8.1-8.6-8.6V3.3h8.1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          <circle cx="7.6" cy="7.5" r="1.3" fill="currentColor" />
        </svg>
        <span class="tour-info-label">Modalidad</span>
        <span class="tour-info-value">
          {tour.price && tour.price > 0 ? `Desde $ ${tour.price.toLocaleString()}` : 'A medida'}
        </span>
      </div>
    </div>
  </div>

  <!-- CONTENT -->
  <section class="tour-detail-section">
    <div class="container tour-detail-layout">
      <main class="tour-main-content">
        <section class="tour-copy-block">
          <h2>Sobre esta experiencia</h2>

          <p>
            {tour.description ||
              'Sumérjase en una experiencia cuidadosamente diseñada para descubrir Perú con comodidad, autenticidad y acompañamiento experto.'}
          </p>

          {
            highlights.length > 0 && (
              <div class="tour-mini-highlights">
                {highlights.slice(0, 4).map((highlight) => (
                  <span>{highlight}</span>
                ))}
              </div>
            )
          }
        </section>

        {
          itinerary.length > 0 && (
            <section class="tour-itinerary-block">
              <h2>Itinerario Detallado</h2>

              <div class="tour-timeline">
                {itinerary.map((day, dayIndex) => {
                  const dayMeals = day.meals ?? [];
                  const images = getDayImages(dayIndex);

                  return (
                    <article class="timeline-item">
                      <div class="timeline-marker">
                        {String(day.day).padStart(2, '0')}
                      </div>

                      <div class="timeline-content">
                        <h3>{day.title}</h3>

                        <p>{day.description}</p>

                        {
                          (day.accommodations || dayMeals.length > 0) && (
                            <div class="timeline-meta">
                              {day.accommodations && (
                                <span>⌂ {day.accommodations}</span>
                              )}

                              {dayMeals.length > 0 && (
                                <span>☕ {dayMeals.join(', ')}</span>
                              )}
                            </div>
                          )
                        }

                        {
                          images.length > 0 && (
                            <div class="timeline-gallery">
                              {images.map((src) => {
                                const galleryIndex = galleryImages.indexOf(src);
                                return (
                                  <button
                                    type="button"
                                    class="timeline-gallery__item lightbox-trigger"
                                    data-gallery-index={galleryIndex}
                                    aria-label={`Ampliar foto del día ${day.day}`}
                                  >
                                    <img src={src} alt={`${day.title} - foto`} loading="lazy" />
                                  </button>
                                );
                              })}
                            </div>
                          )
                        }
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          )
        }

        {
          includes.length > 0 || notIncludes.length > 0 ? (
            <section class="tour-service-block">
              <h2>Información del servicio</h2>

              <div class="tour-service-grid">
                {
                  includes.length > 0 && (
                    <article>
                      <h3>Incluye</h3>
                      <ul>
                        {includes.slice(0, 8).map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </article>
                  )
                }

                {
                  notIncludes.length > 0 && (
                    <article>
                      <h3>No incluye</h3>
                      <ul>
                        {notIncludes.slice(0, 8).map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </article>
                  )
                }
              </div>
            </section>
          ) : null
        }

        {
          whatToBring.length > 0 && (
            <section class="tour-bring-block">
              <h2>Qué llevar</h2>

              <div class="tour-bring-list">
                {whatToBring.slice(0, 12).map((item) => (
                  <span>{item}</span>
                ))}
              </div>
            </section>
          )
        }

        <section class="tour-gallery-block">
          <h2>Highlights del Recorrido</h2>

          <div class="tour-gallery">
            <button
              type="button"
              class="tour-gallery__large lightbox-trigger"
              data-gallery-index="0"
              aria-label="Ampliar foto 1"
            >
              <img src={galleryImages[0] || heroImage} alt={tour.title} loading="lazy" />
            </button>

            <div class="tour-gallery__side">
              {galleryImages.slice(1, 5).map((src, i, arr) => {
                const hiddenCount = galleryImages.length - 5;
                const isLast = i === arr.length - 1;
                return (
                  <button
                    type="button"
                    class="lightbox-trigger"
                    data-gallery-index={i + 1}
                    aria-label={`Ampliar foto ${i + 2}`}
                  >
                    <img src={src} alt={tour.title} loading="lazy" />
                    {isLast && hiddenCount > 0 && (
                      <span class="tour-gallery__more">+{hiddenCount}</span>
                    )}
                  </button>
                );
              })}
            </div>
          </div>
        </section>
      </main>

      <aside class="tour-sidebar">
        <div class="booking-widget">
          <h3>Diseñe Su Viaje</h3>
          <p>Consultoría Gratuita Experta</p>

          <form class="booking-form">
            <div class="booking-field">
              <label>N° DE VIAJEROS</label>
              <input type="number" placeholder="2 adultos" />
            </div>

            <div class="booking-field">
              <label>FECHA DE VIAJE</label>
              <input type="text" placeholder="dd/mm/yy" />
            </div>

            <a
              href={`https://wa.me/51984544245?text=${encodeURIComponent(whatsappMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="booking-btn"
            >
              Solicitar mi propuesta personalizada
            </a>

            <span>Sin cargos ocultos. Confirmación en 24h.</span>
          </form>
        </div>

        <div class="help-card">
          <div class="help-card__icon">□</div>

          <h3>¿Necesita ayuda?</h3>

          <p>
            Nuestros expertos en Cusco están listos para personalizar su itinerario.
          </p>

          <a
            href={`https://wa.me/51984544245?text=${encodeURIComponent(whatsappMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Contactar asesor
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="tour-reviews-section">
    <div class="container">
      <div class="tour-reviews-header">
        <span class="tour-reviews-eyebrow">Testimonios</span>
        <h2>Lo que dicen nuestros viajeros</h2>
      </div>

      <div class="tour-reviews-grid">
        {reviews.map((review) => (
          <article class="review-card">
            <div class="review-card__stars" aria-label={`${review.rating} de 5 estrellas`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <svg
                  viewBox="0 0 24 24"
                  class={i < review.rating ? 'is-filled' : ''}
                  aria-hidden="true"
                >
                  <path d="M12 2.5l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17.9l-6.1 3.1 1.5-6.8L2.2 9.5l6.9-.7L12 2.5Z" />
                </svg>
              ))}
            </div>

            <p class="review-card__text">"{review.text}"</p>

            <div class="review-card__author">
              <span class="review-card__avatar">{getInitials(review.name)}</span>
              <div>
                <strong>{review.name}</strong>
                <span>{review.location}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div id="lightbox" class="lightbox" aria-hidden="true">
    <button type="button" class="lightbox__close" aria-label="Cerrar">✕</button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" aria-label="Foto anterior">‹</button>
    <img class="lightbox__image" src="" alt="" />
    <button type="button" class="lightbox__nav lightbox__nav--next" aria-label="Siguiente foto">›</button>
  </div>

  <script type="application/json" id="gallery-data" set:html={JSON.stringify(galleryImages)} />
</Layout>

<script>
  const galleryData = document.getElementById('gallery-data');
  const images: string[] = galleryData ? JSON.parse(galleryData.textContent || '[]') : [];

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = lightbox?.querySelector<HTMLImageElement>('.lightbox__image');
  const closeBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__close');
  const prevBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__nav--prev');
  const nextBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__nav--next');
  const triggers = document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger');

  if (lightbox && lightboxImg && images.length > 0) {
    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    const show = (index: number) => {
      currentIndex = (index + images.length) % images.length;
      lightboxImg.src = images[currentIndex];
      lightboxImg.alt = `Foto ${currentIndex + 1} de ${images.length}`;
    };

    const open = (index: number) => {
      lastFocused = document.activeElement as HTMLElement;
      show(index);
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    };

    const close = () => {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    triggers.forEach((trigger) => {
      const index = Number(trigger.dataset.galleryIndex ?? -1);
      if (index < 0 || index >= images.length) return;
      trigger.addEventListener('click', () => open(index));
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => show(currentIndex - 1));
    nextBtn?.addEventListener('click', () => show(currentIndex + 1));

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(currentIndex - 1);
      if (e.key === 'ArrowRight') show(currentIndex + 1);
    });
  }
</script>
