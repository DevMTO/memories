---
import '../../styles/admin.scss';
import { sitePath } from '../../core/site-path';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/webp" href={sitePath('/images/ISOTIPOS/ISOTIPO-MEMORIES-TRAVEL-1.webp')} />
    <title>{title} | Memories Travel Perú</title>
  </head>
  <body class="admin-body">
    <slot />
  </body>
</html>
