---
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import QuoteForm from '../components/ui/QuoteForm.astro';
import '../styles/global.scss';

interface Props {
  title: string;
  mainClass?: string;
  showQuoteForm?: boolean;
  preloadImage?: string;
}

const { title, mainClass, showQuoteForm = true, preloadImage } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Memories Travel Peru - Experiencias exclusivas de viaje"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href="/images/ISOTIPOS/ISOTIPO-MEMORIES-TRAVEL-1.webp" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Memories Travel Peru</title>
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
  </head>

  <body>
    <Header />

    <main class={mainClass}>
      <slot />
    </main>

    {showQuoteForm && <QuoteForm />}

    <Footer />
  </body>
</html>