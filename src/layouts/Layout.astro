---
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import QuoteForm from '../components/ui/QuoteForm.astro';
import QuoteFab from '../components/ui/QuoteFab.astro';
import WhatsAppFab from '../components/ui/WhatsAppFab.astro';
import { sitePath } from '../lib/site-path';
import Hreflang from '#kit/site/Hreflang.astro';
import PreviewRibbon from '#kit/site/PreviewRibbon.astro';
import { isPreview } from '#kit/site/preview.ts';
import { defaultLang, enabledLangs, localeHref, pageLang, useT } from '../i18n/i18n';
import '../styles/global.scss';

interface Props {
  title: string;
  mainClass?: string;
  description?: string;
  preloadImage?: string;
  socialImage?: string;
}

const lang = pageLang(Astro.params);
const t = useT(lang);

const {
  title,
  mainClass,
  description = t('Memories Travel Perú: tours, trekkings y paquetes personalizados con atención local desde Cusco.'),
  preloadImage,
  socialImage,
} = Astro.props;

const documentTitle = /memories travel/i.test(title)
  ? title
  : `${title} | Memories Travel Perú`;
const metaDescription = description.trim().replace(/\s+/g, ' ').slice(0, 160);
// La misma página en cada idioma (hreflang).
const alternates = enabledLangs.map((code) => ({ code, href: localeHref(Astro.url, lang, code) }));

const absoluteSocialImage = socialImage
  ? new URL(sitePath(socialImage), Astro.url).toString()
  : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={metaDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href={sitePath('/images/ISOTIPOS/ISOTIPO-MEMORIES-TRAVEL-1.webp')} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    {absoluteSocialImage && <meta property="og:image" content={absoluteSocialImage} />}
    <title>{documentTitle}</title>
    {isPreview() && <meta name="robots" content="noindex, nofollow" />}
    <Hreflang alternates={alternates} defaultHref={localeHref(Astro.url, lang, defaultLang)} />
    {preloadImage && (
      <link rel="preload" as="image" href={sitePath(preloadImage)} fetchpriority="high" />
    )}
  </head>

  <body>
    <PreviewRibbon />
    <a class="skip-link" href="#main-content">{t('Saltar al contenido')}</a>

    <div class="site-shell">
      <Header />

      <main id="main-content" class:list={["site-content", mainClass]}>
        <slot />
      </main>

      <Footer />
    </div>

    <QuoteForm />
    <QuoteFab />
    <WhatsAppFab />
  </body>
</html>
