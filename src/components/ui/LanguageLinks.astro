---
// Enlaces a esta misma página en cada idioma publicado (ENABLED_LANGS).
import { enabledLangs, localeHref, pageLang } from '../../i18n/i18n';

interface Props {
  class?: string;
}

const NAMES: Record<string, string> = { es: 'Español', en: 'English', pt: 'Português' };

const lang = pageLang(Astro.params);
const { class: className = 'language-switcher' } = Astro.props;
---

{enabledLangs.length > 1 && (
  <div class={`${className} notranslate`} translate="no">
    <svg class="language-switcher__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 5h9M8.5 3v2m1.8 0c-.6 3-2.2 5.7-4.6 7.7M5.9 9.5c1.1 1.5 2.5 2.7 4.1 3.6M14.5 19l2.8-7 2.8 7m-4.7-2.3h3.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <div class="language-switcher__options">
      {enabledLangs.map((code) => (
        <a
          class="language-switcher__button"
          href={localeHref(Astro.url, lang, code)}
          hreflang={code}
          lang={code}
          aria-label={NAMES[code] ?? code}
          aria-current={code === lang ? 'true' : undefined}
        >
          {code.toUpperCase()}
        </a>
      ))}
    </div>
  </div>
)}
