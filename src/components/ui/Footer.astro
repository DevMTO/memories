---
import "./Footer.scss";
import { sitePath } from "../../core/site-path";

const primaryWhatsApp = '51908043192';
const emergencyPhone = '51954669589';
---

<footer class="footer">
  <div class="footer-art" aria-hidden="true" style={`--footer-art-image: url('${sitePath('/images/footer.png')}')`}></div>

  <div class="footer-main">
    <div class="footer-content container">
      <div class="footer-grid">
        <div class="footer-col footer-brand">
          <a
            href={sitePath("/")}
            class="footer-logo"
            aria-label="Memories Travel Perú"
          >
            <img
              src={sitePath("/images/ISOTIPOS/ISOTIPO-MEMORIES-TRAVEL-4.webp")}
              alt=""
              class="footer-logo-mark"
              width="1080"
              height="1080"
            />
            <img
              src={sitePath(
                "/images/LOGOTIPOS/LOGOTIPO-MEMORIES-TRAVEL-5.webp",
              )}
              alt="Memories Travel"
              class="footer-logo-wordmark"
              width="1080"
              height="301"
            />
          </a>

          <p data-i18n="footer.description">
            Comparta sus planes con nosotros. Un especialista en viajes de lujo
            curará una propuesta exclusiva adaptada a sus preferencias.
          </p>

        </div>

        <div class="footer-col">
          <h4 data-i18n="footer.explore">Explorar</h4>
          <ul>
            <li><a href={sitePath("/#destinations")} data-i18n="footer.destinations">Destinos</a></li>
            <li><a href={sitePath("/tours")} data-i18n="footer.experiences">Experiencias</a></li>
            <li><a href={sitePath("/blogs")}>Blogs</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 data-i18n="footer.company">Empresa</h4>
          <ul>
            <li><a href={sitePath("/about")} data-i18n="footer.about">Quiénes somos</a></li>
            <li><a href={sitePath("/terms")} data-i18n="footer.terms">Términos y condiciones</a></li>
          </ul>
        </div>

        <div class="footer-col footer-contact">
          <h4 data-i18n="footer.contact">Contacto</h4>
          <ul>
            <li>Luis Vallejo Santoni C-2, Santiago - <span class="notranslate" translate="no">Cusco</span></li>
            <li><a href={`https://wa.me/${primaryWhatsApp}`} target="_blank" rel="noopener noreferrer">WhatsApp: +51 908 043 192</a></li>
            <li><a href={`tel:+${emergencyPhone}`}><span data-i18n="footer.emergency">Emergencias</span>: +51 954 669 589</a></li>
          </ul>
        </div>

      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© 2026 Memories Travel Perú</p>
  </div>
</footer>
