---
import './Footer.scss';
import { sitePath } from '../../lib/site-path';
import { SITE_DEVELOPER, buildWhatsAppUrl } from '../../config/site';
import { getContact } from '../../lib/services/site';
import { pageLang, pagePath, useT } from '../../i18n/i18n';

const SITE_CONTACT = await getContact();
const lang = pageLang(Astro.params);
const t = useT(lang);

const whatsappUrl = buildWhatsAppUrl(SITE_CONTACT.whatsappNumber, t('Hola, quisiera recibir información sobre sus tours y paquetes.'));
---

<footer class="footer">
  <div class="footer-art" aria-hidden="true" style={`--footer-art-image: url('${sitePath('/images/footer.png')}')`}></div>

  <div class="footer-main">
    <div class="footer-content container">
      <div class="footer-grid">
        <div class="footer-col footer-brand">
          <a href={pagePath(lang, '/')} class="footer-logo" aria-label="Memories Travel Perú">
            <img src={sitePath('/images/ISOTIPOS/ISOTIPO-MEMORIES-TRAVEL-4.webp')} alt="" class="footer-logo-mark" width="1080" height="1080" />
            <img src={sitePath('/images/LOGOTIPOS/LOGOTIPO-MEMORIES-TRAVEL-5.webp')} alt="Memories Travel" class="footer-logo-wordmark" width="1080" height="301" />
          </a>
          <p>{t('Comparta sus planes con nosotros. Un especialista diseñará una propuesta adaptada a sus preferencias.')}</p>
        </div>

        <div class="footer-col">
          <h4>{t('Explorar')}</h4>
          <ul>
            <li><a href={pagePath(lang, '/packages')}>{t('Paquetes')}</a></li>
            <li><a href={pagePath(lang, '/tours')}>{t('Tours')}</a></li>
            <li><a href={pagePath(lang, '/trekkings')}>{t('Trekking')}</a></li>
            <li><a href={pagePath(lang, '/#destinations')}>{t('Destinos')}</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>{t('Empresa')}</h4>
          <ul>
            <li><a href={pagePath(lang, '/about')}>{t('Quiénes somos')}</a></li>
            <li><a href={pagePath(lang, '/terms')}>{t('Términos y condiciones')}</a></li>
            <li><a href={pagePath(lang, '/esnna')}>{t('Turismo responsable')}</a></li>
          </ul>
        </div>

        <div class="footer-col footer-contact">
          <h4>{t('Contacto')}</h4>
          <div class="footer-contact-list">
            <div class="footer-contact-item footer-contact-item--address">
              <span class="footer-contact-icon" aria-hidden="true">⌖</span>
              <div><small>{t('Oficina')}</small><span>{SITE_CONTACT.address}</span></div>
            </div>
            <a class="footer-contact-item" href={`mailto:${SITE_CONTACT.email}`}>
              <span class="footer-contact-icon" aria-hidden="true">@</span>
              <div><small>{t('Correo')}</small><strong>{SITE_CONTACT.email}</strong></div>
            </a>
            <a class="footer-contact-item" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
              <span class="footer-contact-icon" aria-hidden="true">◉</span>
              <div><small>WhatsApp</small><strong>{SITE_CONTACT.whatsappDisplay}</strong></div>
            </a>
            <a class="footer-contact-item footer-contact-item--emergency" href={`tel:+${SITE_CONTACT.emergencyNumber}`}>
              <span class="footer-contact-icon" aria-hidden="true">!</span>
              <div><small>{t('Emergencias')}</small><strong>{SITE_CONTACT.emergencyDisplay}</strong></div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© 2026 Memories Travel Perú</p>
    <a class="footer-credit" href={SITE_DEVELOPER.url} target="_blank" rel="noopener noreferrer">
      <span>{t('Desarrollado por')}</span>
      <img src={sitePath('/images/logo-turix.webp')} alt={SITE_DEVELOPER.name} class="footer-credit-logo" width="400" height="97" loading="lazy" />
    </a>
  </div>
</footer>
