---
import './Header.scss';
import LanguageSwitcher from './LanguageSwitcher';
import { sitePath } from '../../core/site-path';
import { SITE_CONTACT, buildWhatsAppUrl } from '../../config/site';

const navItems = [
  { href: sitePath('/packages'), label: 'Paquetes', key: 'nav.packages' },
  { href: sitePath('/tours'), label: 'Tours', key: 'nav.tours' },
  { href: sitePath('/trekkings'), label: 'Trekking', key: 'nav.trekking' },
  { href: sitePath('/flights'), label: 'Vuelos', key: 'nav.flights' },
  { href: sitePath('/about'), label: 'Nosotros', key: 'nav.about' },
  { href: sitePath('/blogs'), label: 'Blog', key: 'nav.blogs' },
];

const whatsappUrl = buildWhatsAppUrl('Hola, quiero diseñar un viaje con Memories Travel Perú.');

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="header-top">
    <div class="container header-top__inner">
      <div class="header-top__contact">
        <a href={`mailto:${SITE_CONTACT.email}`}>
          <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3.5 5.5h17a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-17a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.6" />
            <path d="m3 6.5 9 6.5 9-6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {SITE_CONTACT.email}
        </a>

        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1.1.5 1.1 1.1v3.4c0 .6-.5 1.1-1.1 1.1C10.9 21.2 2.8 13.1 2.8 3.2c0-.6.5-1.1 1.1-1.1H7.3c.6 0 1.1.5 1.1 1.1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          </svg>
          {SITE_CONTACT.whatsappDisplay}
        </a>

        <a href={`tel:+${SITE_CONTACT.emergencyNumber}`} aria-label={`Emergencias ${SITE_CONTACT.emergencyDisplay}`}>
          <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3.2 21 19H3L12 3.2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            <path d="M12 9v4.6M12 17.1v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          Emergencias: {SITE_CONTACT.emergencyDisplay}
        </a>
      </div>

      <div class="header-top__actions">
        <LanguageSwitcher client:load />
      </div>
    </div>
  </div>

  <nav class="main-nav">
    <div class="container main-nav__inner">
      <a href={sitePath('/')} class="logo" aria-label="Memories Travel Perú">
        <img src={sitePath('/images/IMAGOTIPO-MEMORIES-TRAVEL-5.png')} alt="Memories Travel Perú" class="logo-image" width="1080" height="716" />
      </a>

      <ul class="nav-links">
        {navItems.map((item) => (
          <li>
            <a href={item.href} data-i18n={item.key} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <button
        type="button"
        class="design-trip-btn"
        data-open-quote
        aria-haspopup="dialog"
        aria-controls="quote-modal"
      >
        <span data-i18n="nav.designTrip">Diseña tu viaje</span>
      </button>

      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <span class="menu-toggle__bar"></span>
        <span class="menu-toggle__bar"></span>
        <span class="menu-toggle__bar"></span>
      </button>
    </div>
  </nav>
</header>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Navegación principal">
  <div class="mobile-menu__inner">
    <ul class="mobile-menu__links">
      {navItems.map((item) => (
        <li>
          <a href={item.href} data-i18n={item.key} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      type="button"
      class="mobile-menu__cta"
      data-open-quote
      aria-haspopup="dialog"
      aria-controls="quote-modal"
    >
      <span data-i18n="nav.designTrip">Diseña tu viaje</span>
    </button>

    <div class="mobile-language-switcher notranslate" role="group" aria-label="Seleccionar idioma">
      <svg class="language-switcher__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 5h9M8.5 3v2m1.8 0c-.6 3-2.2 5.7-4.6 7.7M5.9 9.5c1.1 1.5 2.5 2.7 4.1 3.6M14.5 19l2.8-7 2.8 7m-4.7-2.3h3.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <button type="button" class="language-switcher__button" data-language="es" aria-label="Español" aria-pressed="true">ES</button>
      <button type="button" class="language-switcher__button" data-language="en" aria-label="English" aria-pressed="false">EN</button>
      <button type="button" class="language-switcher__button" data-language="pt" aria-label="Português" aria-pressed="false">PT</button>
    </div>

    <div class="mobile-menu__contact">
      <a href={`mailto:${SITE_CONTACT.email}`}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3.5 5.5h17a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-17a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.6" />
          <path d="m3 6.5 9 6.5 9-6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        {SITE_CONTACT.email}
      </a>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1.1.5 1.1 1.1v3.4c0 .6-.5 1.1-1.1 1.1C10.9 21.2 2.8 13.1 2.8 3.2c0-.6.5-1.1 1.1-1.1H7.3c.6 0 1.1.5 1.1 1.1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        </svg>
        {SITE_CONTACT.whatsappDisplay}
      </a>
      <a href={`tel:+${SITE_CONTACT.emergencyNumber}`}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3.2 21 19H3L12 3.2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          <path d="M12 9v4.6M12 17.1v.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        Emergencias: {SITE_CONTACT.emergencyDisplay}
      </a>
    </div>

  </div>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const menuItems = menu.querySelectorAll<HTMLElement>('a, button[data-open-quote]');

    const openMenu = () => {
      menu.classList.add('is-open');
      toggle.classList.add('is-open');
      document.body.classList.add('is-mobile-menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Cerrar menú');
      menu.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => menuItems[0]?.focus());
    };

    const closeMenu = (returnFocus = false) => {
      menu.classList.remove('is-open');
      toggle.classList.remove('is-open');
      document.body.classList.remove('is-mobile-menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Abrir menú');
      menu.setAttribute('aria-hidden', 'true');
      if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      menu.classList.contains('is-open') ? closeMenu(true) : openMenu();
    });

    menuItems.forEach((item) => item.addEventListener('click', () => closeMenu(false)));

    menu.addEventListener('click', (event) => {
      if (event.target === menu) closeMenu(true);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) closeMenu(true);
    });

    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusable = Array.from(menu.querySelectorAll<HTMLElement>('a, button'));
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    const desktopQuery = window.matchMedia('(min-width: 769px)');
    desktopQuery.addEventListener('change', (e) => {
      if (e.matches) closeMenu(false);
    });
  }
</script>
