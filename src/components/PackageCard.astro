---
import type { Package } from '../core/domain/models';
import { sitePath } from '../core/site-path';
import './PackageCard.scss';

interface Props {
  pkg: Package;
}

const { pkg } = Astro.props;

const imageUrl =
  pkg.imageUrl &&
  pkg.imageUrl.trim() !== '' &&
  !pkg.imageUrl.includes('---')
    ? pkg.imageUrl
    : '/images/cusco/cusco.png';

const durationDays = pkg.durationDays || 1;

const locationLabel =
  pkg.destinations?.map((d) => d.name).slice(0, 1).join(', ') ||
  'Perú';

const description =
  pkg.shortDescription ||
  pkg.description ||
  'Descubre una experiencia diseñada con detalle, comodidad y autenticidad.';

const priceLabel =
  pkg.price && pkg.price > 0
    ? `$ ${pkg.price.toLocaleString()}`
    : 'A medida';

const detailUrl = sitePath(`/packages/${pkg.slug || pkg.id}`);
const resolvedImageUrl = sitePath(imageUrl);
---

<article class="package-card">
  <a href={detailUrl} class="package-card__image">
    <img src={resolvedImageUrl} alt={pkg.title} />

    <span class="package-card__badge">
      <span data-i18n-count="cards.days" data-count={durationDays}>{durationDays} días</span>
    </span>
  </a>

  <div class="package-card__body">
    <span class="package-card__location notranslate" translate="no">
      {locationLabel.toUpperCase()}
    </span>

    <h3>
      <a href={detailUrl}>
        {pkg.title}
      </a>
    </h3>

    <p>{description}</p>

    <div class="package-card__footer">
      <div class="package-card__price">
        <span data-i18n="cards.from">Desde</span>
        <strong>{pkg.price && pkg.price > 0 ? priceLabel : <span data-i18n="cards.tailorMade">A medida</span>}</strong>
      </div>

      <a
        href={detailUrl}
        class="package-card__arrow"
        aria-label={`Ver ${pkg.title}`}
      >
        →
      </a>
    </div>
  </div>
</article>
