---
import type { Tour } from '../core/domain/models';
import { sitePath } from '../core/site-path';
import './TourCard.scss';

interface Props {
  tour: Tour;
}

const { tour } = Astro.props;

const imageUrl =
  tour.imageUrl &&
  tour.imageUrl.trim() !== '' &&
  !tour.imageUrl.includes('---')
    ? tour.imageUrl
    : '/images/cusco.png';

const durationDays = tour.durationDays || 1;

const locationLabel = tour.destinationName || tour.location || 'Perú';

const description =
  tour.shortDescription ||
  tour.description ||
  'Descubre una experiencia diseñada con detalle, comodidad y autenticidad.';

const priceLabel =
  tour.price && tour.price > 0
    ? `$ ${tour.price.toLocaleString()}`
    : 'A medida';

const detailUrl = sitePath(`/tours/${tour.slug || tour.id}`);
const resolvedImageUrl = sitePath(imageUrl);
---

<article class="tour-card">
  <a href={detailUrl} class="tour-card__image">
    <img src={resolvedImageUrl} alt={tour.title} />

    <span class="tour-card__badge">
      <span data-i18n-count="cards.days" data-count={durationDays}>{durationDays} días</span>
    </span>
  </a>

  <div class="tour-card__body">
    <span class="tour-card__location">
      {locationLabel.toUpperCase()}
    </span>

    <h3>
      <a href={detailUrl}>
        {tour.title}
      </a>
    </h3>

    <p>{description}</p>

    <div class="tour-card__footer">
      <div class="tour-card__price">
        <span data-i18n={tour.price && tour.price > 0 ? 'cards.from' : 'cards.consult'}>{tour.price && tour.price > 0 ? 'Desde' : 'Consultar'}</span>
        <strong>{tour.price && tour.price > 0 ? priceLabel : <span data-i18n="cards.tailorMade">A medida</span>}</strong>
      </div>

      <a
        href={detailUrl}
        class="tour-card__arrow"
        aria-label={`Ver ${tour.title}`}
      >
        →
      </a>
    </div>
  </div>
</article>
