---
import type { Tour } from '../lib/types';
import { sitePath } from '../lib/site-path';
import { pageLang, pagePath, useT } from '../i18n/i18n';
import './TourCard.scss';

interface Props {
  tour: Tour;
}

const { tour } = Astro.props;
const lang = pageLang(Astro.params);
const t = useT(lang);

const imageUrl =
  tour.imageUrl &&
  tour.imageUrl.trim() !== '' &&
  !tour.imageUrl.includes('---')
    ? tour.imageUrl
    : '/images/cusco/cusco.png';

const durationDays = tour.durationDays || 1;

const locationLabel = tour.destinationName || tour.location || 'Perú';

const description =
  tour.shortDescription ||
  tour.description ||
  t('Descubre una experiencia diseñada con detalle, comodidad y autenticidad.');

const priceLabel =
  tour.price && tour.price > 0
    ? `$ ${tour.price.toLocaleString()}`
    : t('A medida');

const detailUrl = pagePath(lang, `/tours/${tour.slug || tour.id}`);
const resolvedImageUrl = sitePath(imageUrl);
---

<article class="tour-card">
  <a href={detailUrl} class="tour-card__image">
    <img src={resolvedImageUrl} alt={tour.title} />

    <span class="tour-card__badge">
      <span>{durationDays} {t('días')}</span>
    </span>
  </a>

  <div class="tour-card__body">
    <span class="tour-card__location notranslate" translate="no">
      {locationLabel.toUpperCase()}
    </span>

    <h3>
      <a href={detailUrl}>
        {tour.title}
      </a>
    </h3>

    <p>{description}</p>

    <div class="tour-card__footer">
      <div class="tour-card__price">
        <span>{tour.price && tour.price > 0 ? t('Desde') : t('Consultar')}</span>
        <strong>{tour.price && tour.price > 0 ? priceLabel : <span>{t('A medida')}</span>}</strong>
      </div>

      <a
        href={detailUrl}
        class="tour-card__arrow"
        aria-label={`${t('Ver')} ${tour.title}`}
      >
        →
      </a>
    </div>
  </div>
</article>
