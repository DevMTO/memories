---
// Barra del editor en la vista previa (solo con PREVIEW=1): editor.<dominio> sirve
// solo la vista previa, y la barra deja claro que no es el sitio publicado. Va al
// principio del <body>; en el <head>, `isPreview()` agrega el noindex.
import { isPreview } from './preview.ts';

const liveUrl = process.env.SITE_URL || '';
---

{isPreview() && (
    <div style="position: fixed; z-index: 9999; left: 50%; bottom: 12px; transform: translateX(-50%); display: flex; gap: 8px; align-items: center; max-width: calc(100vw - 24px); padding: 6px 6px 6px 14px; border-radius: 999px; background: #8a5a00; color: #fff; font: 600 13px/1.4 system-ui, sans-serif; box-shadow: 0 2px 10px rgb(0 0 0 / 0.3); white-space: nowrap;">
      <span style="letter-spacing: 0.08em;">EDITOR</span>
      <span style="overflow: hidden; text-overflow: ellipsis; font-weight: 400;">Vista previa: no es el sitio publicado</span>
      <a
        href="/admin/"
        style="border-radius: 999px; padding: 4px 12px; background: #fff; color: #8a5a00; text-decoration: none;"
      >
        ✎ Editar
      </a>
      {liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener"
          style="border-radius: 999px; padding: 4px 12px; border: 1px solid rgb(255 255 255 / 0.6); color: #fff; text-decoration: none;"
        >
          Sitio publicado ↗
        </a>
      )}
    </div>
)}
