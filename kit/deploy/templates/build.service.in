# Copiar a /etc/systemd/system/. Lo lanza @UNIT@-build.path (pedidos);
# a mano: sudo systemctl start @UNIT@-build (log: journalctl -u @UNIT@-build).
[Unit]
Description=Build y publicación del sitio (@APP@)
After=network-online.target @PB_SERVICE@.service
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
Group=@USER@
# Ver kit/deploy/build.sh.
Environment=APP=@APP@ PB_PORT=@PB_PORT@ PB_SERVICE=@PB_SERVICE@
# PUBLISH_CALLBACK_SECRET (para reportar el estado a PocketBase y armar la vista previa).
EnvironmentFile=/etc/@APP@/pocketbase.env
# SITE_URL, ENABLED_LANGS, PUBLIC_POCKETBASE_URL, EDITOR_URL.
EnvironmentFile=/etc/@APP@/build.env
# CF_PAGES_PROJECT, CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN (subir el sitio a
# Cloudflare Pages). Aparte de pocketbase.env para que PocketBase no vea el
# token; opcional (-).
EnvironmentFile=-/etc/@APP@/cloudflare.env
# CPANEL_FTP_HOST, CPANEL_FTP_USER, CPANEL_FTP_PASSWORD, CPANEL_FTP_DIR (subir el
# sitio a un hosting compartido con cPanel, kit/deploy/cpanel.md); opcional (-).
EnvironmentFile=-/etc/@APP@/cpanel.env
ExecStart=/srv/@APP@/repo/kit/deploy/build.sh
TimeoutStartSec=30min
# El build no le quita CPU al sitio ni a PocketBase.
Nice=10
