# Valores de este sitio en el VPS. `kit/deploy/render.sh deploy` genera con ellos los
# archivos de deploy/ y deploy/despliegue.md. Sin secretos: van en /etc/<app>/ del VPS.
SITE_NAME="Memories Travel Perú"
APP=memories
PB_PORT=8091
PUBLIC=cpanel
SITE_HOST=example.com
EDITOR_HOST=editor.example.com
PB_HOST=pb.example.com
BACKUP_CRON="30 9 * * *"
ENABLED_LANGS=es,en,pt
DEFAULT_LANG=en
# La cotización abre WhatsApp: sin formularios por correo.
FORMS=none
