# Caddy en el VPS: sirve el editor (/admin y la vista previa) y hace de proxy a
# PocketBase, con HTTPS automático (Let's Encrypt). Sus bloques van en
# /etc/caddy/Caddyfile; el DNS de los dos dominios debe apuntar al VPS antes de
# recargar Caddy. Los visitantes ven el sitio público (memoriestravelperu.com); aquí solo está
# la vista previa, fuera de los buscadores.

editor.memoriestravelperu.com {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"

	# Archivos con hash en el nombre: nunca cambian.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# HTML y demás: siempre se revalida para ver el contenido recién publicado.
	@other not path /_astro/*
	header @other Cache-Control "no-cache"
	header Vary Cookie

	# Solo la vista previa (kit/deploy/build.sh la rearma después de cada
	# publicación), y solo a quien tenga la cookie que pone /admin mientras la sesión
	# es válida. Sin ella, solo /admin (el login) y sus archivos (/_astro/); lo demás
	# redirige a /admin/. CLAVE = PREVIEW_KEY de pocketbase.env (obligatoria).
	root * /srv/memories/preview
	@guest {
		not header Cookie *site_preview=CLAVE*
		not path /admin /admin/* /_astro/*
	}
	redir @guest /admin/ 302
	file_server
}

pb.memoriestravelperu.com {
	reverse_proxy 127.0.0.1:8091
}
