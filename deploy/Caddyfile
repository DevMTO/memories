# Caddy en el VPS: sirve el sitio para el editor (/admin y la vista previa) y
# hace de proxy a PocketBase, con HTTPS automático (Let's Encrypt). Sus bloques van
# en /etc/caddy/Caddyfile; el DNS de los dos dominios debe apuntar al VPS antes de
# recargar Caddy. Los visitantes ven el sitio público (example.com); aquí es una
# copia para el editor, fuera de los buscadores.

editor.example.com {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"

	# Archivos con hash en el nombre: nunca cambian.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# HTML y demás: siempre se revalida para ver el contenido recién publicado.
	@other not path /_astro/*
	header @other Cache-Control "no-cache"
	header Vary Cookie

	# Vista previa del editor (kit/deploy/build.sh): las mismas URLs, servidas desde
	# otra carpeta a quien tenga la cookie que pone /admin. CLAVE = PREVIEW_KEY de
	# pocketbase.env. Sin vista previa, quitar este bloque.
	@preview header Cookie *site_preview=CLAVE*
	handle @preview {
		root * /srv/memories/preview
		file_server
	}

	handle {
		root * /srv/memories/site
		file_server
	}
}

pb.example.com {
	reverse_proxy 127.0.0.1:8091
}
